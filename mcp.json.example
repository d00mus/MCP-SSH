{
  "mcpServers": {
    "ssh-gateway": {
      "command": "mcp-ssh-gateway",
      "args": [
        "--servers-config", "C:\\tools\\ssh-gateway\\servers.json",
        "--project-root", "C:\\work",
        "--cache-dir", "C:\\tools\\ssh-gateway\\.ssh-cache"
      ],
      "env": {
        "KEENETIC_PASSWORD": "<replace-with-a-secret; do-not-commit>"
      }
    },

    "ssh-gateway-docker": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-v", "C:/tools/ssh-gateway/servers.json:/app/servers.json:ro",
        "-v", "C:/Users/username/.ssh:/root/.ssh:ro",
        "-v", "C:/tools/ssh-gateway/.ssh-cache:/app/.ssh-cache",
        "mcp-ssh-server",
        "--servers-config", "/app/servers.json",
        "--cache-dir", "/app/.ssh-cache"
      ],
      "env": {
        "KEENETIC_PASSWORD": "<replace-with-a-secret; do-not-commit>"
      }
    }
  }
}
